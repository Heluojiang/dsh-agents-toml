{
  "name": "@heluojiang/dsh-agents-toml",
  "version": "0.3.1",
  "description": "DeepSeek Harness plugin: declare named subagents in TOML files under ~/.dsh/agents and <projectRoot>/.dsh/agents",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "guide",
    "LICENSE"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heluojiang/dsh-agents-toml.git"
  },
  "homepage": "https://github.com/Heluojiang/dsh-agents-toml#readme",
  "bugs": {
    "url": "https://github.com/Heluojiang/dsh-agents-toml/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "subagent",
    "agents",
    "toml",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -p tsconfig.build.json",
    "build:client": "tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "typecheck": "npm run typecheck:host && npm run typecheck:client",
    "typecheck:host": "tsc -p tsconfig.json",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "pretest": "npm run build:client",
    "test": "node --test \"tests/**/*.spec.ts\"",
    "check:docs": "node scripts/check-docs.mjs",
    "check:harness": "node scripts/check-harness-shape.mjs",
    "check": "npm run typecheck && npm run check:docs && npm run test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.0"
  }
}
